# UrsBiz Backend — Environment Variables
# Copy this file to .env and edit as needed.
# -------------------------------------------------------

# ----- Application -----
APP_NAME=UrsBiz
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8001

# ----- CORS -----
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- Logging -----
LOG_LEVEL=INFO

# ----- Database -----
# Development: SQLite (zero-config, auto-created on startup).
DATABASE_URL=sqlite:///./ursbiz.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/ursbiz
DB_ECHO=false

# ----- AI Provider -----
# "placeholder" = deterministic rule-based AI (no external service needed).
# "ollama"      = local Ollama LLM server (optional, requires Ollama installed).
# "openai_compatible" = any OpenAI-compatible endpoint (Gemini, Together, vLLM, etc.).
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.0-flash
AI_REQUIRE_SCHEMA=true
AI_REQUEST_TIMEOUT_SECONDS=60
AI_HARD_CALL_TIMEOUT_SECONDS=150

# Ollama-specific knobs (only used when AI_PROVIDER=ollama).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# AI tunables (safe defaults provided in code)
AI_GROUNDING_THRESHOLD=50
AI_DEFAULT_MODE=grounded
AI_MAX_HISTORY_TURNS=8
KNOWLEDGE_RETRIEVAL_TOP_K=3

# ----- Authentication -----
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET_KEY=generate_a_secure_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Set true in production (requires HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=true
COOKIE_PATH=/
COOKIE_MAX_AGE_SECONDS=3600

# ----- Trusted proxy / rate limiting -----
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ENDPOINT_OVERRIDES=/api/v1/business/ocr:10,/api/v1/business/ocr/apply:10,/api/v1/auth/login:10,/api/v1/auth/register:5

# ----- Request body limits -----
MAX_REQUEST_BODY_BYTES=1048576
MAX_UPLOAD_BODY_BYTES=26214400

# ----- Security headers -----
SECURITY_HEADERS_ENABLED=true
STRICT_TRANSPORT_SECURITY=
STRICT_TRANSPORT_SECURITY_MAX_AGE=31536000
STRICT_TRANSPORT_SECURITY_INCLUDE_SUBDOMAINS=true
STRICT_TRANSPORT_SECURITY_PRELOAD=false
SECURITY_AUDIT_ENABLED=true

# ----- DB connection pool (used for non-SQLite) -----
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30

# ----- Performance -----
GZIP_ENABLED=true
GZIP_MINIMUM_SIZE=1024
GZIP_COMPRESS_LEVEL=5
HEALTH_RESPONSE_CACHE_CONTROL=no-store, max-age=0
